<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <TextView
        android:id="@+id/status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:textSize="18sp"
        android:textStyle="bold"
        android:text="@string/status_idle" />

    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Spelled out as AppCompatButton: under a Material theme a plain
         <Button> inflates to MaterialButton, which replaces the round
         background drawable with its own. -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/connect_button"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:background="@drawable/round_button_bg"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:elevation="4dp"
        android:text="@string/action_connect" />

    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Connection stats, filled from nativeStatus while in a call. Fixed
         height (one line per value, two for Video and its optional "limited
         by" line), so changing values don't shift the Connect button. -->
    <TableLayout
        android:id="@+id/stats_table"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:shrinkColumns="1"
        android:stretchColumns="1"
        android:visibility="invisible">

        <TableRow android:paddingVertical="3dp">

            <TextView
                android:paddingEnd="16dp"
                android:textColor="?android:attr/textColorSecondary"
                android:text="@string/stats_duration" />

            <TextView
                android:id="@+id/stats_duration"
                android:ellipsize="end"
                android:maxLines="1"
                android:fontFeatureSettings="tnum" />

        </TableRow>

        <TableRow android:paddingVertical="3dp">

            <TextView
                android:paddingEnd="16dp"
                android:textColor="?android:attr/textColorSecondary"
                android:text="@string/stats_up" />

            <TextView
                android:id="@+id/stats_up"
                android:ellipsize="end"
                android:maxLines="1"
                android:fontFeatureSettings="tnum" />

        </TableRow>

        <TableRow android:paddingVertical="3dp">

            <TextView
                android:paddingEnd="16dp"
                android:textColor="?android:attr/textColorSecondary"
                android:text="@string/stats_down" />

            <TextView
                android:id="@+id/stats_down"
                android:ellipsize="end"
                android:maxLines="1"
                android:fontFeatureSettings="tnum" />

        </TableRow>

        <TableRow android:paddingVertical="3dp">

            <TextView
                android:paddingEnd="16dp"
                android:textColor="?android:attr/textColorSecondary"
                android:text="@string/stats_capacity" />

            <TextView
                android:id="@+id/stats_capacity"
                android:ellipsize="end"
                android:maxLines="1"
                android:fontFeatureSettings="tnum" />

        </TableRow>

        <TableRow android:paddingVertical="3dp">

            <TextView
                android:paddingEnd="16dp"
                android:textColor="?android:attr/textColorSecondary"
                android:text="@string/stats_latency" />

            <TextView
                android:id="@+id/stats_latency"
                android:ellipsize="end"
                android:maxLines="1"
                android:fontFeatureSettings="tnum" />

        </TableRow>

        <TableRow android:paddingVertical="3dp">

            <TextView
                android:paddingEnd="16dp"
                android:textColor="?android:attr/textColorSecondary"
                android:text="@string/stats_video" />

            <TextView
                android:id="@+id/stats_video"
                android:ellipsize="end"
                android:lines="2"
                android:fontFeatureSettings="tnum" />

        </TableRow>

    </TableLayout>

</LinearLayout>
