<?xml version="1.0" encoding="utf-8"?>
<!-- All three tabs live in this one activity and are switched by
     visibility, so the tunnel status and log pollers have a single
     lifecycle to follow. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/tab_main"
            layout="@layout/tab_main" />

        <include
            android:id="@+id/tab_settings"
            layout="@layout/tab_settings"
            android:visibility="gone" />

        <include
            android:id="@+id/tab_log"
            layout="@layout/tab_log"
            android:visibility="gone" />

    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav" />

</LinearLayout>
