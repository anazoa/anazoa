<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape: the stacked portrait layout left the config editor about two
     lines tall, so the controls move to a column beside it and the editor
     gets the tab's full height. Same view ids as layout/tab_settings.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="16dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_cidr" />

        <EditText
            android:id="@+id/cidr_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:inputType="textNoSuggestions"
            android:text="@string/default_cidr" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_media" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/load_media_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:paddingStart="0dp"
                android:text="@string/action_load_media" />

            <TextView
                android:id="@+id/media_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textStyle="italic"
                android:text="@string/media_status_none" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_config" />

        <Button
            android:id="@+id/import_config_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:paddingStart="0dp"
            android:text="@string/action_import_config" />

    </LinearLayout>

    <EditText
        android:id="@+id/config_input"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:gravity="top|start"
        android:inputType="textMultiLine|textNoSuggestions"
        android:typeface="monospace"
        android:textSize="12sp"
        android:hint="@string/hint_config" />

</LinearLayout>
