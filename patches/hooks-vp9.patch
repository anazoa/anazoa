+class TunnelEncoderSink : public VideoStreamEncoderInterface::EncoderSink {
+ public:
+  explicit TunnelEncoderSink(VideoStreamEncoderInterface::EncoderSink* inner)
+      : inner_(inner) {}
+
+  Result OnEncodedImage(const EncodedImage& encoded_image,
+                        const CodecSpecificInfo* codec_specific_info) override {
+    if (inner_ == nullptr) {
+      return Result(Result::Error::ERROR_SEND_FAILED);
+    }
+    if (hook_after_vp9_encode == nullptr ||
+        codec_specific_info == nullptr ||
+        codec_specific_info->codecType != kVideoCodecVP9) {
+      return inner_->OnEncodedImage(encoded_image, codec_specific_info);
+    }
+
+    size_t hook_size = encoded_image.size();
+    const bool is_key_frame =
+        encoded_image.FrameType() == VideoFrameType::kVideoFrameKey;
+    if (!hook_after_vp9_encode(encoded_image.data(), encoded_image.size(),
+                               nullptr, &hook_size, 0,
+                               encoded_image.RtpTimestamp(),
+                               is_key_frame)) {
+      return inner_->OnEncodedImage(encoded_image, codec_specific_info);
+    }
+
+    std::vector<uint8_t> hook_data(hook_size);
+    if (!hook_after_vp9_encode(encoded_image.data(), encoded_image.size(),
+                               hook_data.data(), &hook_size,
+                               hook_data.size(),
+                               encoded_image.RtpTimestamp(),
+                               is_key_frame) ||
+        hook_size > hook_data.size()) {
+      return inner_->OnEncodedImage(encoded_image, codec_specific_info);
+    }
+
+    hook_data.resize(hook_size);
+    EncodedImage image = encoded_image;
+    image.SetEncodedData(
+        EncodedImageBuffer::Create(hook_data.data(), hook_data.size()));
+    return inner_->OnEncodedImage(image, codec_specific_info);
+  }
+
+  void OnDroppedFrame(DropReason reason) override {
+    if (inner_ != nullptr) {
+      inner_->OnDroppedFrame(reason);
+    }
+  }
+
+  void OnEncoderConfigurationChanged(
+      std::vector<VideoStream> streams,
+      bool is_svc,
+      VideoEncoderConfig::ContentType content_type,
+      int min_transmit_bitrate_bps) override {
+    if (inner_ != nullptr) {
+      inner_->OnEncoderConfigurationChanged(std::move(streams), is_svc,
+                                            content_type,
+                                            min_transmit_bitrate_bps);
+    }
+  }
+
+  void OnBitrateAllocationUpdated(
+      const VideoBitrateAllocation& allocation) override {
+    if (inner_ != nullptr) {
+      inner_->OnBitrateAllocationUpdated(allocation);
+    }
+  }
+
+  void OnVideoLayersAllocationUpdated(
+      VideoLayersAllocation allocation) override {
+    if (inner_ != nullptr) {
+      inner_->OnVideoLayersAllocationUpdated(std::move(allocation));
+    }
+  }
+
+ private:
+  VideoStreamEncoderInterface::EncoderSink* const inner_;
+};
