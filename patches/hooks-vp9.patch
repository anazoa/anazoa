+void RewriteTunnelCompleteFrame(EncodedFrame* frame) {
+  if (frame == nullptr || hook_before_vp9_reference_find == nullptr) {
+    return;
+  }
+  const VideoCodecType codec_type = frame->CodecSpecific()->codecType;
+  if (codec_type != kVideoCodecVP9 && codec_type != kVideoCodecGeneric) {
+    return;
+  }
+
+  size_t hook_size = frame->size();
+  bool hook_is_key_frame =
+      frame->FrameType() == VideoFrameType::kVideoFrameKey;
+  if (!hook_before_vp9_reference_find(
+          frame->data(), frame->size(), nullptr, &hook_size, 0,
+          frame->RtpTimestamp(), hook_is_key_frame, &hook_is_key_frame)) {
+    return;
+  }
+
+  std::vector<uint8_t> hook_data(hook_size);
+  if (!hook_before_vp9_reference_find(
+          frame->data(), frame->size(), hook_data.data(), &hook_size,
+          hook_data.size(), frame->RtpTimestamp(),
+          frame->FrameType() == VideoFrameType::kVideoFrameKey,
+          &hook_is_key_frame) ||
+      hook_size > hook_data.size()) {
+    return;
+  }
+
+  hook_data.resize(hook_size);
+  frame->SetEncodedData(EncodedImageBuffer::Create(hook_data.data(),
+                                                   hook_data.size()));
+  frame->SetFrameType(hook_is_key_frame ? VideoFrameType::kVideoFrameKey
+                                        : VideoFrameType::kVideoFrameDelta);
+}
+
+class TunnelFrameCallback
+    : public RtpVideoStreamReceiver2::OnCompleteFrameCallback {
+ public:
+  explicit TunnelFrameCallback(
+      RtpVideoStreamReceiver2::OnCompleteFrameCallback* inner)
+      : inner_(inner) {}
+
+  void OnCompleteFrame(std::unique_ptr<EncodedFrame> frame) override {
+    RewriteTunnelCompleteFrame(frame.get());
+    if (inner_ != nullptr) {
+      inner_->OnCompleteFrame(std::move(frame));
+    }
+  }
+
+ private:
+  RtpVideoStreamReceiver2::OnCompleteFrameCallback* const inner_;
+};
